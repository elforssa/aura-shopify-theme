{% comment %}
  ----------------------------------------------------------------------------
  Section: Aura Reviews (FR)
  ----------------------------------------------------------------------------
  @description
    Reviews carousel from the v2 design — summary header + arrow controls +
    horizontal snap track of review cards (one featured/dark). Styles in
    assets/aura-v2.css (.reviews). Arrows driven by assets/aura-v2.js. Each
    review is an editable block.
  ----------------------------------------------------------------------------
{% endcomment %}

<section class="reviews" id="reviews" data-section="reviews">
  <div class="reviews-head">
    <div>
      <div class="eyebrow">{{ section.settings.eyebrow | escape }}</div>
      <h2 class="h-display h-section">{{ section.settings.heading | escape }}</h2>
      <div class="summary" style="margin-top: 24px">
        <div class="big">{{ section.settings.score | escape }}</div>
        <div>
          <span class="stars ss">★★★★<span class="star-off">★</span></span>
          <div class="meta">{{ section.settings.meta | escape }}</div>
        </div>
      </div>
    </div>
  </div>

  <div class="reviews-viewport">
  <div class="reviews-track" id="reviews-track">
    {%- for block in section.blocks -%}
      <div class="review-card{% if block.settings.featured %} featured{% endif %}" {{ block.shopify_attributes }}>
        <div class="top"><span class="stars">{% if block.settings.half %}★★★★☆{% else %}★★★★★{% endif %}</span><span class="verified">✓ {{ block.settings.verified_label | escape }}</span></div>
        <div class="title">{{ block.settings.title | escape }}</div>
        <div class="body">{{ block.settings.body | escape }}</div>
        <div class="author"><div class="av">{{ block.settings.initials | escape }}</div><div class="au"><div class="n">{{ block.settings.name | escape }}</div><div class="r">{{ block.settings.role | escape }}</div></div></div>
      </div>
    {%- endfor -%}
  </div>
  </div>
  <div class="carousel-nav">
    <button class="carousel-arrow" id="rev-prev" aria-label="Précédent"><svg width="15" height="15" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M8.5 2.5l-5 4.5 5 4.5"/></svg></button>
    <button class="carousel-arrow" id="rev-next" aria-label="Suivant"><svg width="15" height="15" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M5.5 2.5l5 4.5-5 4.5"/></svg></button>
  </div>
</section>

{% schema %}
{
  "name": "Aura Reviews",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Vrais avis · vérifiés"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Portées par des infirmières dans toute la France."
    },
    {
      "type": "text",
      "id": "score",
      "label": "Overall rating",
      "default": "4,8"
    },
    {
      "type": "text",
      "id": "meta",
      "label": "Meta",
      "default": "150+ avis d'infirmières"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "checkbox",
          "id": "featured",
          "label": "Highlight (dark)",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "half",
          "label": "4 stars (instead of 5)",
          "default": false
        },
        {
          "type": "text",
          "id": "verified_label",
          "label": "Verified label",
          "default": "Achat vérifié"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Titre de l'avis"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Review",
          "default": "Texte de l'avis."
        },
        {
          "type": "text",
          "id": "initials",
          "label": "Initials",
          "default": "CL"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Camille L."
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role",
          "default": "IDE · CHU"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Aura Reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "featured": true,
            "verified_label": "Achat vérifié",
            "title": "« Rentrée à la maison, et j'ai cuisiné le dîner. »",
            "body": "Avant, je posais mon sac à la porte et je m'allongeais par terre, jambes contre le mur. Après trois mois en Aura, je rentre et je cuisine. C'est tout l'avis.",
            "initials": "CL",
            "name": "Camille L.",
            "role": "IDE urgentiste · CHU Lyon Sud · 11 mois de port"
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "M'a portée pendant la semaine d'intégration.",
            "body": "La pointe sans couture est la seule raison qui m'a fait tenir. La paire d'avant m'avait donné une ampoule au 3ᵉ jour ; Aura a tenu toute la rotation sans une seule.",
            "initials": "MD",
            "name": "Marion D.",
            "role": "IDE Gériatrie · Bordeaux"
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "Lavées et reportées, un an et demi après.",
            "body": "Bordeaux le lundi, Gris le jeudi. Lavage à 30°, séchage à l'air. La compression est comme au premier jour. J'avais usé quatre marques moins chères avant.",
            "initials": "JR",
            "name": "Juliette R.",
            "role": "Sage-femme · Maternité Paris 14e"
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "J'en ai racheté 4 le dimanche.",
            "body": "Sceptique. Portées 14 heures d'affilée un samedi. Commandé quatre paires de plus le soir même. Les mollets ne brûlent plus à la dixième heure.",
            "initials": "TB",
            "name": "Thomas B.",
            "role": "Aide-soignant · EHPAD Lille"
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "Valent leurs 34 €, et je suis exigeante.",
            "body": "J'ai testé quatre marques au même prix. Aura est la seule avec un bord-côte qui ne roule pas, une couture de pointe qu'on ne sent pas, et une pression qui semble pensée.",
            "initials": "SO",
            "name": "Sophie O.",
            "role": "IDE Bloc op. · Marseille"
          }
        },
        {
          "type": "review",
          "settings": {
            "half": true,
            "title": "Pris une taille au-dessus : parfait.",
            "body": "Conseil : j'ai pris une taille au-dessus du guide et elles sont idéales. Sinon, des chaussettes brillantes. Le tableau de mesure du mollet vaut de l'or.",
            "initials": "LE",
            "name": "Léa E.",
            "role": "Infirmière puéricultrice · Nantes"
          }
        }
      ]
    }
  ]
}
{% endschema %}
