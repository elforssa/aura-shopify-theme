    { "type": "text", "id": "sticky_label", "label": "Texte (ex. OFFRE DE LANCEMENT)" },
    { "type": "text", "id": "sticky_deadline", "label": "Échéance (date ISO ex. 2026-07-06T23:59, ou texte)", "info": "Une date ISO active le compte à rebours ; sinon le texte s'affiche tel quel." },
    { "type": "text", "id": "sticky_cta", "label": "Bouton — libellé" },
    { "type": "url", "id": "sticky_link", "label": "Bouton — lien" }
  ],
  "blocks": [
    {
      "type": "raison",
      "name": "Bloc d'article",
      "settings": [
        { "type": "checkbox", "id": "numbered", "label": "Afficher le numéro (mode liste)", "default": true },
        { "type": "html", "id": "title", "label": "Titre de l'argument", "default": "Fini les marques rouges en fin de garde" },
