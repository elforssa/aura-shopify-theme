{% comment %}
  ----------------------------------------------------------------------------
  Snippet: aura-globals
  ----------------------------------------------------------------------------
  Global Aura v2 UI rendered once before </body>: the sticky add-to-cart bar
  and the LIVE cart drawer. The drawer is rendered from the real {{ cart }}
  on first paint and kept in sync by assets/aura-cart.js (Shopify AJAX cart).
  ----------------------------------------------------------------------------
{% endcomment %}

<div class="sticky-atc" id="sticky-atc">
  <div class="thumb" id="sticky-thumb" style="background:#F4EFE7"></div>
  {%- comment -%}
    Line 1 = the chosen pack, line 2 = colour + free pairs (or size for a single
    pair) — short enough never to truncate on a phone. The buy box
    (aura-featured-product) keeps these in sync.
  {%- endcomment -%}
  <div class="info">
    <div class="n" id="sticky-pack">1 paire</div>
    <div class="v"><span id="sticky-color">Bordeaux</span> · <span id="sticky-size">taille à choisir</span></div>
  </div>
  <div class="price"><span id="sticky-price">34 €</span><s class="was" id="sticky-was" hidden></s></div>
  <button class="btn btn-coral" id="sticky-btn" aria-label="Ajouter au panier">Ajouter<span class="sticky-btn-long"> au panier</span> <span class="arrow">→</span></button>
</div>

<div class="drawer-overlay" id="drawer-overlay"></div>
<aside class="drawer{% if cart.item_count == 0 %} is-empty{% endif %}" id="drawer" aria-label="Panier" data-free-shipping="6000">
  <div class="drawer-head">
    <div class="h">Votre panier <span class="count" id="drawer-count">{{ cart.item_count }} {% if cart.item_count == 1 %}article{% else %}articles{% endif %}</span></div>
    <button class="drawer-close" id="drawer-close" aria-label="Fermer le panier">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M3 3l8 8M11 3l-8 8"/></svg>
    </button>
  </div>

  <div class="drawer-items" id="drawer-items">
    {%- for it in cart.items -%}
      <div class="drawer-item" data-key="{{ it.key }}">
        {%- if it.image -%}<img class="thumb" src="{{ it.image | image_url: width: 128 }}" alt="" width="64" height="64" style="object-fit:cover;">{%- else -%}<div class="thumb"></div>{%- endif -%}
        <div>
          <div class="n">{{ it.product.title | default: it.title | replace: 'Bas de contention', 'Chaussettes de compression' }}</div>
          <div class="m">{{ it.variant.title }}</div>
          <div class="qty"><button type="button" data-dec aria-label="Retirer une paire">−</button><span>{{ it.quantity }}</span><button type="button" data-inc aria-label="Ajouter une paire">+</button></div>
        </div>
        <div class="p">{% render 'aura-money', cents: it.final_line_price %}</div>
      </div>
    {%- else -%}
      {%- render 'aura-drawer-empty' -%}
    {%- endfor -%}
  </div>
  {%- comment -%} Re-used by aura-cart.js whenever the cart becomes empty. {%- endcomment -%}
  <template id="drawer-empty-tpl">{%- render 'aura-drawer-empty' -%}</template>

  <div class="drawer-foot">
    <div class="row"><span>Sous-total</span><span id="drawer-subtotal">{% render 'aura-money', cents: cart.total_price %}</span></div>
    <div class="row drawer-discount-row" id="drawer-discount-row"{% if cart.total_discount <= 0 %} hidden{% endif %}><span>Réduction</span><span id="drawer-discount" style="color:var(--green);font-weight:600">−{% render 'aura-money', cents: cart.total_discount %}</span></div>
    <div class="row"><span>Livraison</span><span id="drawer-shipping" class="drawer-shipping{% if cart.total_price >= 6000 %} is-free{% endif %}">{% if cart.total_price >= 6000 %}Offerte{% else %}Offerte dès 60&nbsp;€{% endif %}</span></div>
    <div class="row total"><span>Total</span><span id="drawer-total">{% render 'aura-money', cents: cart.total_price %}</span></div>
    <button class="btn btn-coral" id="drawer-checkout">Passer au paiement <span class="arrow">→</span></button>
    <div class="note">Paiement sécurisé · {% render 'aura-payment-methods', style: 'text' %}</div>
  </div>
</aside>

<script src="{{ 'aura-v2.js' | asset_url }}" defer></script>
<script src="{{ 'aura-cart.js' | asset_url }}" defer></script>
