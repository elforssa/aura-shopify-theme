{% comment %}
  ----------------------------------------------------------------------------
  Section: Aura Page — Guide des tailles (FR)
  ----------------------------------------------------------------------------
  @description
    Size guide page: centred head, 3 measuring steps next to an illustration
    slot, the size table (same data as the buy-box modal), reassurance card,
    closing CTA. Styles in assets/aura-v2.css (.pg). Assign template
    "page.tailles" to the page.
  ----------------------------------------------------------------------------
{% endcomment %}

<div class="pg" data-section="page-tailles">
  <div class="pg-inner">
    <div class="pg-head">
      <div class="eyebrow">{{ section.settings.eyebrow | escape }}</div>
      <h1 class="h-display h-section">{{ section.settings.heading | escape }}</h1>
      <p class="lead">{{ section.settings.lead | escape }}</p>
    </div>

    <div class="pg-grid2">
      <div class="pg-steps">
        <div class="pg-step"><span class="n">1</span><div><div class="t">{{ section.settings.step1_title | escape }}</div><div class="d">{{ section.settings.step1_body | escape }}</div></div></div>
        <div class="pg-step"><span class="n">2</span><div><div class="t">{{ section.settings.step2_title | escape }}</div><div class="d">{{ section.settings.step2_body | escape }}</div></div></div>
        <div class="pg-step"><span class="n">3</span><div><div class="t">{{ section.settings.step3_title | escape }}</div><div class="d">{{ section.settings.step3_body | escape }}</div></div></div>
      </div>
      <div class="pg-media">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 1000 }}" alt="{{ section.settings.heading | escape }}" width="1000" height="750" loading="lazy">
        {%- else -%}
          <div class="ph"><span class="ph-label">{{ section.settings.image_label | escape }}</span></div>
        {%- endif -%}
      </div>
    </div>

    <div class="pg-table">
      <div class="cap"><span>{{ section.settings.table_cap_l | escape }}</span><span class="val">{{ section.settings.table_cap_r | escape }}</span></div>
      {{ section.settings.table }}
    </div>

  </div>

  <div class="pg-band">
    <div class="pg-inner">
      <div class="pg-head" style="margin-bottom:26px">
        <div class="eyebrow">{{ section.settings.tips_eyebrow | escape }}</div>
        <h2 class="h-display">{{ section.settings.tips_heading | escape }}</h2>
      </div>
      <div class="pg-cards3 two">
        <div class="pg-card" style="margin-top:0">
          <div class="t">{{ section.settings.tip_title | escape }}</div>
          <div class="d">{{ section.settings.tip_body | escape }}</div>
        </div>
        <div class="pg-card" style="margin-top:0">
          <div class="t">{{ section.settings.note_title | escape }}</div>
          <div class="d">{{ section.settings.note_body | escape }}</div>
          <a class="pg-qa-link" href="{{ section.settings.note_url | escape }}">{{ section.settings.note_link | escape }}</a>
        </div>
      </div>
    </div>
  </div>

  <div class="pg-close">
    <div class="eyebrow">{{ section.settings.close_eyebrow | escape }}</div>
    <h2>{{ section.settings.close_heading | escape }}</h2>
    <p>{{ section.settings.close_lead | escape }}</p>
    <a class="btn btn-coral" href="{{ section.settings.cta_url }}">{{ section.settings.cta_label | escape }} <span class="arrow">→</span></a>
    <div class="note">{{ section.settings.cta_note | escape }}</div>
  </div>
</div>

{% schema %}
{
  "name": "Aura Page — Tailles",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Guide des tailles" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Trouvez votre taille en 30 secondes." },
    { "type": "textarea", "id": "lead", "label": "Sous-titre", "default": "La plupart des infirmières prennent leur pointure habituelle. En cas de doute, le tableau ci-dessous précise tout." },
    { "type": "header", "content": "Étapes" },
    { "type": "text", "id": "step1_title", "label": "Étape 1 — titre", "default": "Prenez votre pointure habituelle" },
    { "type": "textarea", "id": "step1_body", "label": "Étape 1 — texte", "default": "Celle de vos chaussures de tous les jours. Pas besoin de mètre ruban : votre pointure suffit." },
    { "type": "text", "id": "step2_title", "label": "Étape 2 — titre", "default": "Repérez votre taille dans le tableau" },
    { "type": "textarea", "id": "step2_body", "label": "Étape 2 — texte", "default": "Trouvez votre pointure dans la colonne EU ci-dessous : la ligne vous donne votre taille (S/M, L/XL ou XXL)." },
    { "type": "text", "id": "step3_title", "label": "Étape 3 — titre", "default": "Entre deux tailles ? Prenez la plus grande." },
    { "type": "textarea", "id": "step3_body", "label": "Étape 3 — texte", "default": "Une taille plus large épouse mieux la jambe, évite les marques, et garde toute son efficacité." },
    { "type": "image_picker", "id": "image", "label": "Illustration" },
    { "type": "text", "id": "image_label", "label": "Libellé du placeholder", "default": "Comment mesurer — schéma à venir" },
    { "type": "text", "id": "table_cap_l", "label": "Tableau — libellé gauche", "default": "Aura — guide des tailles" },
    { "type": "text", "id": "table_cap_r", "label": "Tableau — libellé droit", "default": "Pointures EU 35–48" },
    { "type": "html", "id": "table", "label": "Tableau des tailles", "default": "<table><thead><tr><th>Taille</th><th>Pointure (EU)</th><th>Largeur cheville*</th><th>Longueur jambe</th><th>Longueur pied*</th></tr></thead><tbody><tr><td>S/M</td><td>35–39</td><td>11 cm</td><td>32 cm</td><td>16,5 cm</td></tr><tr><td>L/XL</td><td>40–44</td><td>12 cm</td><td>33 cm</td><td>18,5 cm</td></tr><tr><td>XXL</td><td>45–48</td><td>13 cm</td><td>35 cm</td><td>20,5 cm</td></tr></tbody></table><p>*Mesures du bas posé à plat — la maille s'étire. Hauteur du bord : 2,5 cm.</p>" },
    { "type": "header", "content": "Bande conseils" },
    { "type": "text", "id": "tips_eyebrow", "label": "Conseils — eyebrow", "default": "Deux repères" },
    { "type": "text", "id": "tips_heading", "label": "Conseils — titre", "default": "Bien ajustée, jamais serrée." },
    { "type": "text", "id": "tip_title", "label": "Conseil — titre", "default": "Ça doit tenir, jamais couper" },
    { "type": "textarea", "id": "tip_body", "label": "Conseil — texte", "default": "Une compression graduée serre plus à la cheville qu'au mollet : ferme au réveil, oubliée ensuite. Si elle marque fort dès la première heure, prenez la taille au-dessus." },
    { "type": "text", "id": "note_title", "label": "Note — titre", "default": "Toujours hésitante ?" },
    { "type": "textarea", "id": "note_body", "label": "Note — texte", "default": "Écrivez-nous avec votre pointure : on vous répond avec la taille exacte. Et si elle ne convient pas, l'échange est gratuit pendant 30 jours." },
    { "type": "text", "id": "note_link", "label": "Note — lien (libellé)", "default": "Nous écrire →" },
    { "type": "text", "id": "note_url", "label": "Note — lien (URL)", "default": "/pages/contact" },
    { "type": "header", "content": "Bande finale" },
    { "type": "text", "id": "close_eyebrow", "label": "Eyebrow", "default": "Prête ?" },
    { "type": "text", "id": "close_heading", "label": "Titre", "default": "Votre taille vous attend." },
    { "type": "textarea", "id": "close_lead", "label": "Texte", "default": "S/M à XXL, trois coloris, et trente jours pour juger sur une vraie garde." },
    { "type": "text", "id": "cta_label", "label": "Bouton", "default": "Choisir ma taille" },
    { "type": "url", "id": "cta_url", "label": "Lien du bouton" },
    { "type": "text", "id": "cta_note", "label": "Note sous le bouton", "default": "Échange gratuit si la taille ne convient pas." }
  ],
  "presets": [{ "name": "Aura Page — Tailles" }]
}
{% endschema %}
