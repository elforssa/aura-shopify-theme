{% comment %}
  ----------------------------------------------------------------------------
  Section: Aura Newsletter (FR)
  ----------------------------------------------------------------------------
  @description
    "Shift letter" newsletter band from the Aura v2 design. Styles in
    assets/aura-v2.css (.newsletter). Uses Shopify's customer form so signups
    are captured, and says so after the redirect (success / error lines,
    announced to screen readers). Renders via footer-group.json.
  ----------------------------------------------------------------------------
{% endcomment %}

<div class="newsletter" data-section="newsletter">
  <div class="newsletter-inner">
    <h3>{{ section.settings.heading }}</h3>
    {%- if section.settings.body != blank -%}<p>{{ section.settings.body | escape }}</p>{%- endif -%}
    {%- form 'customer', id: 'aura-newsletter-form' -%}
      {%- if form.posted_successfully? -%}
        <p class="newsletter-msg ok" role="status">{{ section.settings.success_text | escape }}</p>
      {%- else -%}
        {%- if form.errors -%}
          {%- if form.errors.messages['email'] contains 'déjà' or form.errors.messages['email'] contains 'taken' -%}
            <p class="newsletter-msg err" role="alert">{{ section.settings.taken_text | escape }}</p>
          {%- else -%}
            <p class="newsletter-msg err" role="alert">{{ section.settings.error_text | escape }}</p>
          {%- endif -%}
        {%- endif -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="aura-sr" for="aura-newsletter-email">{{ section.settings.label | escape }}</label>
        <input
          type="email"
          id="aura-newsletter-email"
          name="contact[email]"
          autocomplete="email"
          placeholder="{{ section.settings.placeholder | escape }}"
          {% if form.errors %}aria-invalid="true"{% endif %}
          required
        >
        <button type="submit" class="btn btn-light">{{ section.settings.button_label | escape }}</button>
      {%- endif -%}
    {%- endform -%}
    {%- if section.settings.legal != blank -%}<div class="legal">{{ section.settings.legal | escape }}</div>{%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Aura Newsletter",
  "settings": [
    {
      "type": "html",
      "id": "heading",
      "label": "Heading",
      "default": "La <span class=\"ser\">lettre de garde.</span>"
    },
    {
      "type": "text",
      "id": "body",
      "label": "Text",
      "default": "Une note mensuelle pour les infirmières : récupération, science du mollet, conseils d'ajustement de notre équipe. Jamais de spam, promis."
    },
    {
      "type": "text",
      "id": "label",
      "label": "Field label (screen readers)",
      "default": "Votre adresse e-mail"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email placeholder",
      "default": "vous@hôpital.fr"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button",
      "default": "S'inscrire"
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Message after signing up",
      "default": "Merci, c'est noté. La prochaine lettre de garde arrive dans votre boîte mail."
    },
    {
      "type": "text",
      "id": "error_text",
      "label": "Message if the address is invalid",
      "default": "Cette adresse e-mail ne semble pas valide. Vérifiez-la, puis réessayez."
    },
    {
      "type": "text",
      "id": "taken_text",
      "label": "Message if already subscribed",
      "default": "Vous êtes déjà inscrite : la prochaine lettre de garde arrive bientôt."
    },
    {
      "type": "text",
      "id": "legal",
      "label": "Legal note",
      "default": "En vous inscrivant, vous acceptez notre politique de confidentialité. Désinscription en un clic."
    }
  ]
}
{% endschema %}
