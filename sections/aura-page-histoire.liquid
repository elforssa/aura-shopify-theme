{% comment %}
  ----------------------------------------------------------------------------
  Section: Aura Page — Notre histoire (FR)
  ----------------------------------------------------------------------------
  @description
    Brand story page: centred head, full-width hero image slot, alternating
    image/text story rows (blocks), one serif quote moment (quotes are the
    sanctioned serif use), closing CTA to the product. Styles in
    assets/aura-v2.css (.pg). Assign template "page.histoire" to the page.
  @blocks
    - row : image + heading + body
  ----------------------------------------------------------------------------
{% endcomment %}

<div class="pg" data-section="page-histoire">
  <div class="pg-inner">
    <div class="pg-head">
      <div class="eyebrow">{{ section.settings.eyebrow | escape }}</div>
      <h1 class="h-display h-section">{{ section.settings.heading | escape }}</h1>
      <p class="lead">{{ section.settings.lead | escape }}</p>
    </div>

    {%- if section.settings.hero_image != blank or section.settings.hero_label != blank -%}
      <div class="pg-hero-media">
        {%- if section.settings.hero_image != blank -%}
          <img src="{{ section.settings.hero_image | image_url: width: 2000 }}" alt="{{ section.settings.heading | escape }}" width="2000" height="857" loading="lazy">
        {%- else -%}
          <div class="ph"><span class="ph-label">{{ section.settings.hero_label | escape }}</span></div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- assign has_media = false -%}
      {%- if block.settings.image != blank or block.settings.image_label != blank -%}{%- assign has_media = true -%}{%- endif -%}
      <div class="pg-story-row{% unless has_media %} pg-story-row--noimg{% endunless %}" {{ block.shopify_attributes }}>
        {%- if has_media -%}
          <div class="pg-media">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 1000 }}" alt="{{ block.settings.heading | escape }}" width="1000" height="750" loading="lazy">
            {%- else -%}
              <div class="ph"><span class="ph-label">{{ block.settings.image_label | escape }}</span></div>
            {%- endif -%}
          </div>
        {%- endif -%}
        <div>
          <span class="pg-num">0{{ forloop.index }}</span>
          <h3>{{ block.settings.heading | escape }}</h3>
          <p>{{ block.settings.body | escape }}</p>
        </div>
      </div>
    {%- endfor -%}

  </div>

  <div class="pg-band">
    <div class="pg-inner">
      {%- if section.settings.quote != blank -%}
        <blockquote class="pg-quote" style="margin-top:0">
          {{ section.settings.quote | escape }}
          {%- if section.settings.quote_by != blank -%}<span class="by">{{ section.settings.quote_by | escape }}</span>{%- endif -%}
        </blockquote>
      {%- endif -%}
      <div class="pg-cards3">
        <div class="pg-card" style="margin-top:0"><div class="t">{{ section.settings.v1_title | escape }}</div><div class="d">{{ section.settings.v1_body | escape }}</div></div>
        <div class="pg-card" style="margin-top:0"><div class="t">{{ section.settings.v2_title | escape }}</div><div class="d">{{ section.settings.v2_body | escape }}</div></div>
        <div class="pg-card" style="margin-top:0"><div class="t">{{ section.settings.v3_title | escape }}</div><div class="d">{{ section.settings.v3_body | escape }}</div></div>
      </div>
    </div>
  </div>

  <div class="pg-close">
    <div class="eyebrow">{{ section.settings.close_eyebrow | escape }}</div>
    <h2>{{ section.settings.close_heading | escape }}</h2>
    <p>{{ section.settings.close_lead | escape }}</p>
    <a class="btn btn-coral" href="{{ section.settings.cta_url }}">{{ section.settings.cta_label | escape }} <span class="arrow">→</span></a>
    <div class="note">{{ section.settings.cta_note | escape }}</div>
  </div>
</div>

{% schema %}
{
  "name": "Aura Page — Histoire",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Notre histoire" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Née pendant une garde de nuit." },
    { "type": "textarea", "id": "lead", "label": "Sous-titre", "default": "Aura est partie d'un constat simple : debout toute la journée, ces jambes méritaient mieux que des bas d'hôpital gris et un garrot en guise de maintien." },
    { "type": "image_picker", "id": "hero_image", "label": "Image principale" },
    { "type": "text", "id": "hero_label", "label": "Libellé du placeholder", "default": "L'équipe Aura — photo à venir" },
    { "type": "text", "id": "quote", "label": "Citation", "default": "« On voulait des chaussettes qu'une infirmière garde avec plaisir, pas par obligation. »" },
    { "type": "text", "id": "quote_by", "label": "Citation — auteur", "default": "L'équipe Aura" },
    { "type": "header", "content": "Trois engagements" },
    { "type": "text", "id": "v1_title", "label": "Engagement 1 — titre", "default": "Conçu avec des soignantes" },
    { "type": "textarea", "id": "v1_body", "label": "Engagement 1 — texte", "default": "Chaque détail vient d'une garde réelle, pas d'un moodboard." },
    { "type": "text", "id": "v2_title", "label": "Engagement 2 — titre", "default": "18–25 mmHg, vérifié" },
    { "type": "textarea", "id": "v2_body", "label": "Engagement 2 — texte", "default": "La compression est contrôlée en pression, pas estimée." },
    { "type": "text", "id": "v3_title", "label": "Engagement 3 — titre", "default": "30 jours pour juger" },
    { "type": "textarea", "id": "v3_body", "label": "Engagement 3 — texte", "default": "Même portée une garde, on la reprend sans question." },
    { "type": "text", "id": "close_eyebrow", "label": "Bande finale — eyebrow", "default": "La suite" },
    { "type": "text", "id": "close_heading", "label": "Bande finale — titre", "default": "Elle s'écrit en garde." },
    { "type": "textarea", "id": "close_lead", "label": "Bande finale — texte", "default": "Si Aura tient sa promesse, c'est à vos jambes d'en juger. Trente jours, une vraie garde, et votre avis." },
    { "type": "text", "id": "cta_label", "label": "Bouton", "default": "Découvrir Aura" },
    { "type": "url", "id": "cta_url", "label": "Lien du bouton" },
    { "type": "text", "id": "cta_note", "label": "Note sous le bouton", "default": "30 jours satisfait ou remboursé, même portée une garde." }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Chapitre",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_label", "label": "Libellé du placeholder", "default": "Photo à venir" },
        { "type": "text", "id": "heading", "label": "Titre", "default": "Le constat" },
        { "type": "textarea", "id": "body", "label": "Texte", "default": "Des gardes de 12 heures, des chevilles marquées, des chaussettes qui roulent avant midi." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Aura Page — Histoire",
      "blocks": [
        { "type": "row", "settings": {
          "image_label": "Garde de nuit — photo à venir",
          "heading": "Le constat",
          "body": "Tout commence auprès d'infirmières françaises. Les mêmes mots revenaient après chaque garde : jambes lourdes, chevilles marquées, chaussettes qui roulent avant midi. Les chaussettes de compression existantes étaient pensées pour la prescription, jamais pour celles qui les portent 12 heures par jour."
        } },
        { "type": "row", "settings": {
          "image_label": "Premiers prototypes — photo à venir",
          "heading": "Deux ans de prototypes",
          "body": "Nous avons conçu Aura avec celles qui allaient la porter : compression graduée 18–25 mmHg vérifiée, pointe sans couture, bord-côte élargi qui ne laisse pas de marque. Chaque version a été portée en garde réelle avant d'être validée."
        } },
        { "type": "row", "settings": {
          "image_label": "Photo à venir",
          "heading": "Aujourd'hui",
          "body": "Aura habille des infirmières, des sages-femmes et des aides-soignantes dans toute la France. La promesse n'a pas bougé : finir sa garde avec des jambes qui suivent encore."
        } }
      ]
    }
  ]
}
{% endschema %}
