        },
        {
          "type": "text",
          "id": "meta",
          "label": "Meta (right)",
          "default": "Inclus"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Aura Pack CTA",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "text": "6 paires d'Aura, vos coloris au choix",
