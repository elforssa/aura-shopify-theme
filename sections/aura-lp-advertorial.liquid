{% comment %}
  ----------------------------------------------------------------------------
  Section: Aura LP — Advertorial / listicle (FR)
  ----------------------------------------------------------------------------
  @description
    Native-content landing page for cold Meta traffic (advertorial format —
    reads like an editorial article, not a store page). Header (eyebrow +
    headline + byline + optional star-rating quote), optional hero image,
    lead, then an ordered list of blocks: numbered/plain article beats,
    inline CTAs, a brand-vs-other comparison table, a TL;DR callout and a
    promo banner — in any order. Optional final CTA with a round guarantee
    badge, and an optional fixed "sticky" sale bar (with JS countdown).
    CTAs whose link is #offre / #acheter scroll to the on-page buy box
    (.product); any real URL (e.g. the product page) passes through.
    Powers all three LP formats: A (listicle), B (story), D (full Hollow).
    Styles: .lp-adv* in assets/aura-v2.css. Mobile obeys the shared system.
  @blocks
    - raison  : article beat (numbered list item OR plain story beat)
    - cta     : inline call-to-action button
    - compare : brand-vs-other comparison table (up to 6 rows)
    - callout : highlighted TL;DR / note box
    - promo   : discount / offer banner
  ----------------------------------------------------------------------------
{% endcomment %}

<article class="lp-adv{% if section.settings.sticky_show %} lp-adv--sticky{% endif %}" data-section="lp-advertorial">
  <header class="lp-adv-head">
    {%- if section.settings.eyebrow != blank -%}<div class="eyebrow">{{ section.settings.eyebrow | escape }}</div>{%- endif -%}
    {%- if section.settings.headline != blank -%}<h1 class="lp-adv-h1 h-display">{{ section.settings.headline }}</h1>{%- endif -%}
    {%- if section.settings.byline != blank -%}<div class="lp-adv-byline">{{ section.settings.byline | escape }}</div>{%- endif -%}
    {%- if section.settings.rating_quote != blank -%}
      <div class="lp-adv-rating">
        <span class="lp-adv-stars" aria-hidden="true">★★★★★</span>
        <span class="lp-adv-rating-q">«&nbsp;{{ section.settings.rating_quote | escape }}&nbsp;»</span>
        {%- if section.settings.rating_author != blank -%}<span class="lp-adv-rating-a">— {{ section.settings.rating_author | escape }}</span>{%- endif -%}
      </div>
    {%- endif -%}
  </header>

  {%- unless section.settings.hide_hero -%}
    {%- if section.settings.image != blank -%}
      <figure class="lp-adv-hero">
        <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.headline | strip_html | escape }}" width="1200" height="800" loading="eager" style="object-fit:cover;width:100%;height:100%;">
        {%- if section.settings.caption != blank -%}<figcaption class="lp-adv-cap">{{ section.settings.caption | escape }}</figcaption>{%- endif -%}
      </figure>
    {%- else -%}
      <figure class="lp-adv-hero"><div class="ph"><span class="ph-label">{{ 'Image éditoriale' }}</span></div></figure>
    {%- endif -%}
  {%- endunless -%}

  {%- if section.settings.lead != blank -%}<div class="lp-adv-lead">{{ section.settings.lead }}</div>{%- endif -%}

  <div class="lp-adv-body">
    {%- assign n = 0 -%}
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'raison' -%}
          {%- if block.settings.numbered -%}{%- assign n = n | plus: 1 -%}{%- endif -%}
          <section class="lp-reason{% unless block.settings.numbered %} lp-reason--plain{% endunless %}" {{ block.shopify_attributes }}>
            {%- if block.settings.title != blank -%}
              <h2 class="lp-reason-title">{%- if block.settings.numbered -%}<span class="lp-reason-num">{{ n }}.</span>{%- endif -%}<span class="lp-reason-ttl">{{ block.settings.title }}</span></h2>
            {%- endif -%}
            {%- if block.settings.numbered -%}
              <figure class="lp-reason-fig">
                {%- if block.settings.image != blank -%}
                  <img class="lp-reason-img" src="{{ block.settings.image | image_url: width: 1000 }}" alt="{{ block.settings.title | strip_html | escape }}" width="1000" height="620" loading="lazy">
                {%- else -%}
                  <div class="ph"><span class="ph-label">Image · argument&nbsp;{{ n }}</span></div>
                {%- endif -%}
              </figure>
            {%- elsif block.settings.image != blank -%}
              <figure class="lp-reason-fig"><img class="lp-reason-img" src="{{ block.settings.image | image_url: width: 1000 }}" alt="{{ block.settings.title | strip_html | escape }}" width="1000" height="620" loading="lazy"></figure>
            {%- endif -%}
            {%- if block.settings.body != blank -%}<div class="lp-reason-text">{{ block.settings.body }}</div>{%- endif -%}
          </section>
        {%- when 'cta' -%}
          <div class="lp-adv-cta" {{ block.shopify_attributes }}>
            {%- if block.settings.text != blank -%}<p class="lp-adv-cta-line">{{ block.settings.text }}</p>{%- endif -%}
            <a class="btn btn-primary" href="{{ block.settings.link | default: '#offre' }}" data-lp-cta>{{ block.settings.label | default: 'Découvrir Aura' }}</a>
            {%- if block.settings.proof != blank -%}<p class="lp-adv-cta-proof">{{ block.settings.proof | escape }}</p>{%- endif -%}
          </div>
        {%- when 'compare' -%}
          <div class="lp-compare" {{ block.shopify_attributes }}>
            <div class="lp-compare-row lp-compare-row--head">
              <span class="lp-compare-c"></span>
              <span class="lp-compare-v lp-compare-v--brand">{{ block.settings.brand_label | escape }}</span>
              <span class="lp-compare-v lp-compare-v--other">{{ block.settings.other_label | escape }}</span>
            </div>
            {%- for i in (1..6) -%}
              {%- capture lk -%}r{{ i }}l{%- endcapture -%}
              {%- capture bk -%}r{{ i }}b{%- endcapture -%}
              {%- capture ok -%}r{{ i }}o{%- endcapture -%}
              {%- if block.settings[lk] != blank -%}
                <div class="lp-compare-row">
                  <span class="lp-compare-c">{{ block.settings[lk] | escape }}</span>
                  <span class="lp-compare-v lp-compare-v--brand">{{ block.settings[bk] | escape }}</span>
                  <span class="lp-compare-v lp-compare-v--other">{{ block.settings[ok] | escape }}</span>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- when 'callout' -%}
          <div class="lp-callout" {{ block.shopify_attributes }}>
            {%- if block.settings.tag != blank -%}<span class="lp-callout-tag">{{ block.settings.tag | escape }}</span>{%- endif -%}
            {%- if block.settings.body != blank -%}<div class="lp-callout-body">{{ block.settings.body }}</div>{%- endif -%}
          </div>
        {%- when 'promo' -%}
          <div class="lp-promo" {{ block.shopify_attributes }}>
            {%- if block.settings.big != blank -%}<div class="lp-promo-big">{{ block.settings.big | escape }}</div>{%- endif -%}
            <div class="lp-promo-copy">
              {%- if block.settings.head != blank -%}<div class="lp-promo-head">{{ block.settings.head | escape }}</div>{%- endif -%}
              {%- if block.settings.sub != blank -%}<div class="lp-promo-sub">{{ block.settings.sub | escape }}</div>{%- endif -%}
              {%- if block.settings.deadline != blank -%}<div class="lp-promo-deadline">{{ block.settings.deadline | escape }}</div>{%- endif -%}
            </div>
            {%- if block.settings.label != blank -%}<a class="btn btn-primary" href="{{ block.settings.link | default: '#offre' }}" data-lp-cta>{{ block.settings.label }}</a>{%- endif -%}
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>

  {%- if section.settings.close_text != blank or section.settings.close_label != blank -%}
    <div class="lp-adv-close">
      {%- if section.settings.close_badge != blank -%}
        <div class="lp-adv-badge">
          <span class="lp-adv-badge-n">{{ section.settings.close_badge | escape }}</span>
          {%- if section.settings.close_badge_text != blank -%}<span class="lp-adv-badge-t">{{ section.settings.close_badge_text | escape }}</span>{%- endif -%}
        </div>
      {%- endif -%}
      {%- if section.settings.close_text != blank -%}<div class="lp-adv-close-text">{{ section.settings.close_text }}</div>{%- endif -%}
      {%- if section.settings.close_label != blank -%}<a class="btn btn-primary" href="{{ section.settings.close_link | default: '#offre' }}" data-lp-cta>{{ section.settings.close_label }}</a>{%- endif -%}
      {%- if section.settings.close_proof != blank -%}<p class="lp-adv-cta-proof">{{ section.settings.close_proof | escape }}</p>{%- endif -%}
    </div>
  {%- endif -%}
</article>

{%- if section.settings.sticky_show -%}
  <div class="lp-sticky" data-lp-sticky data-deadline="{{ section.settings.sticky_deadline | escape }}">
    <div class="lp-sticky-in">
      <div class="lp-sticky-txt">
        {%- if section.settings.sticky_label != blank -%}<strong>{{ section.settings.sticky_label | escape }}</strong>{%- endif -%}
        <span class="lp-sticky-time" data-lp-countdown>{{ section.settings.sticky_deadline | escape }}</span>
      </div>
      {%- if section.settings.sticky_cta != blank -%}<a class="btn btn-primary" href="{{ section.settings.sticky_link | default: '#offre' }}" data-lp-cta>{{ section.settings.sticky_cta | escape }}</a>{%- endif -%}
    </div>
  </div>
{%- endif -%}

<script>
  (function () {
    var sec = document.querySelector('[data-section="lp-advertorial"]');
    // CTA scroll: only intercept the "scroll to the offer" links; real URLs pass through.
    document.querySelectorAll('[data-lp-cta]').forEach(function (a) {
      a.addEventListener('click', function (e) {
        var href = a.getAttribute('href') || '';
        if (href === '#offre' || href === '#acheter') {
          var target = document.querySelector('.product') || document.getElementById('offre');
          if (target) { e.preventDefault(); target.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
        }
      });
    });
    // Optional countdown on the sticky bar (deadline = a date string, e.g. 2026-07-06T23:59).
    var el = document.querySelector('[data-lp-countdown]');
    if (el) {
      var end = Date.parse(el.parentNode.parentNode.parentNode.getAttribute('data-deadline'));
      if (!isNaN(end)) {
        var tick = function () {
          var d = end - Date.now();
          if (d <= 0) { el.textContent = ''; return; }
          var s = Math.floor(d / 1000), days = Math.floor(s / 86400);
          var h = Math.floor((s % 86400) / 3600), m = Math.floor((s % 3600) / 60), ss = s % 60;
          var p = function (x) { return (x < 10 ? '0' : '') + x; };
          el.textContent = (days > 0 ? days + 'j · ' : '') + p(h) + ':' + p(m) + ':' + p(ss);
          requestAnimationFrame(function () {});
        };
        tick(); setInterval(tick, 1000);
      }
    }
  })();
</script>

{% schema %}
{
  "name": "Aura LP — Advertorial",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (sur-titre)", "default": "Santé au travail" },
    { "type": "html", "id": "headline", "label": "Titre éditorial (H1)", "default": "Pourquoi de plus en plus d'infirmières abandonnent les chaussettes de compression de pharmacie" },
    { "type": "text", "id": "byline", "label": "Signature / temps de lecture", "default": "Par la rédaction Aura · 4 min de lecture" },
    { "type": "text", "id": "rating_quote", "label": "Citation étoilée (sous la signature)" },
    { "type": "text", "id": "rating_author", "label": "Auteur de la citation" },
    { "type": "checkbox", "id": "hide_hero", "label": "Masquer l'image de haut de page", "default": false },
    { "type": "image_picker", "id": "image", "label": "Image éditoriale (haut de page)" },
    { "type": "text", "id": "caption", "label": "Légende de l'image" },
    { "type": "richtext", "id": "lead", "label": "Chapô (paragraphe d'introduction)", "default": "<p>Après une garde de 12 heures, les jambes lourdes et les marques rouges ne sont pas une fatalité. Voici ce qui change avec une compression graduée 18–25 mmHg vraiment pensée pour les soignantes.</p>" },
    { "type": "header", "content": "Conclusion (bas de page)" },
    { "type": "text", "id": "close_badge", "label": "Badge garantie — chiffre (ex. 99)" },
    { "type": "text", "id": "close_badge_text", "label": "Badge garantie — texte (ex. jours satisfait ou remboursé)" },
    { "type": "richtext", "id": "close_text", "label": "Texte de conclusion", "default": "<p>Des milliers d'infirmières ont déjà fait le test. La vôtre commence par une simple paire.</p>" },
    { "type": "text", "id": "close_label", "label": "Bouton — libellé", "default": "Je découvre Aura" },
    { "type": "url", "id": "close_link", "label": "Bouton — lien (laisser vide = descendre vers l'offre)" },
    { "type": "text", "id": "close_proof", "label": "Ligne de réassurance sous le bouton", "default": "4,8 ★ · 150+ avis · Livraison offerte dès 60 €" },
