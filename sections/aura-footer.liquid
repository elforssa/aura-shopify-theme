{% comment %}
  ----------------------------------------------------------------------------
  Section: Aura Footer (FR)
  ----------------------------------------------------------------------------
  @description
    Site footer from the Aura v2 design — brand column + link columns + legal
    row + payment badges. Styles in assets/aura-v2.css (footer). Renders via
    footer-group.json. Link columns are editable "column" blocks.
  ----------------------------------------------------------------------------
{% endcomment %}

<footer data-section="footer">
  <div class="footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <div class="logo">{{ section.settings.logo_text | escape }}</div>
        {%- if section.settings.tagline != blank -%}<p>{{ section.settings.tagline | escape }}</p>{%- endif -%}
        <div class="socials">
          <a href="{{ section.settings.instagram | default: '#' }}" aria-label="Instagram"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="2" y="2" width="12" height="12" rx="3"/><circle cx="8" cy="8" r="2.5"/><circle cx="11.5" cy="4.5" r="0.5" fill="currentColor"/></svg></a>
          <a href="{{ section.settings.tiktok | default: '#' }}" aria-label="TikTok"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M9 2v8.5a2.5 2.5 0 1 1-2.5-2.5"/><path d="M9 2c.5 2 2 3 4 3"/></svg></a>
          <a href="{{ section.settings.facebook | default: '#' }}" aria-label="Facebook"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M10 5h-1.5a1 1 0 0 0-1 1V8m0 0v6m0-6H6m1.5 0H10"/></svg></a>
        </div>
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'column' -%}
          <div class="footer-col" {{ block.shopify_attributes }}>
            <h4>{{ block.settings.heading | escape }}</h4>
            {%- assign links = block.settings.links | newline_to_br | split: '<br />' -%}
            {%- for link in links -%}
              {%- assign trimmed = link | strip -%}
              {%- if trimmed != blank -%}
                {%- assign parts = trimmed | split: '|' -%}
                {%- assign lbl = parts[0] | strip -%}
                {%- assign u = parts[1] | strip | default: '#' -%}
                <a href="{{ u }}">{{ lbl }}</a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="footer-bottom">
      <div class="small">{{ section.settings.legal_line }}</div>
      <div class="footer-pay">
        {%- assign badges = section.settings.pay_badges | split: ',' -%}
        {%- for b in badges -%}<span class="pay-badge">{{ b | strip | escape }}</span>{%- endfor -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Aura Footer",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Brand name",
      "default": "Aura"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Subheading",
      "default": "Chaussettes de compression pour celles et ceux qui passent leurs journées debout."
    },
    {
      "type": "url",
      "id": "instagram",
      "label": "Instagram"
    },
    {
      "type": "url",
      "id": "tiktok",
      "label": "TikTok"
    },
    {
      "type": "url",
      "id": "facebook",
      "label": "Facebook"
    },
    {
      "type": "html",
      "id": "legal_line",
      "label": "Legal line",
      "default": "© 2026 Aura · 2403 Rooks Ave, Cheyenne, WY 82007, USA · contact@auralegs.com · +1 (307) 396-4309 <a href=\"#\">Mentions légales</a><a href=\"#\">CGV</a><a href=\"#\">Confidentialité</a>"
    },
    {
      "type": "text",
      "id": "pay_badges",
      "label": "Payment badges (comma-separated)",
      "default": "VISA, MC, CB, PayPal, Apple Pay, Klarna"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Link column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Boutique"
        },
        {
          "type": "textarea",
          "id": "links",
          "label": "Links (one per line)",
          "default": "Aura\nLe pack de 3\nLa Semaine 5 paires\nCartes cadeaux"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Aura Footer",
      "blocks": [
        {
          "type": "column",
          "settings": {
            "heading": "Boutique",
            "links": "Aura\nLe pack de 3\nLa Semaine 5 paires\nCartes cadeaux"
          }
        },
        {
          "type": "column",
          "settings": {
            "heading": "Comprendre",
            "links": "La science\nTrouver ma taille\nGuide d'entretien\nAvis\nJournal"
          }
        },
        {
          "type": "column",
          "settings": {
            "heading": "Aide",
            "links": "Livraison & retours\nFAQ\nÉquipes & hôpitaux\nContact\nSuivi de commande"
          }
        },
        {
          "type": "column",
          "settings": {
            "heading": "Aura",
            "links": "Notre histoire\nPresse\nRecrutement\nDurabilité\nAffiliation"
          }
        }
      ]
    }
  ]
}
{% endschema %}
