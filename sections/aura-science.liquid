{% comment %}
  ----------------------------------------------------------------------------
  Section: Aura Science (FR)
  ----------------------------------------------------------------------------
  @description
    Compression explainer from the Aura v2 design — copy + graduated-pressure
    bars on the left, annotated anatomy illustration on the right. Styles in
    assets/aura-v2.css (.science).
  ----------------------------------------------------------------------------
{% endcomment %}

<section class="science" id="science" data-section="science">
  <div class="science-grid">
    <div>
      <div class="eyebrow">{{ section.settings.eyebrow | escape }}</div>
      <h2 class="h-display h-section">{{ section.settings.heading }}</h2>
      {%- if section.settings.para1 != blank -%}<p>{{ section.settings.para1 }}</p>{%- endif -%}
      {%- if section.settings.para2 != blank -%}<p>{{ section.settings.para2 }}</p>{%- endif -%}

      <div class="pressure-bars">
        <div class="lbl"><span>{{ section.settings.bars_label | escape }}</span><span class="val">{{ section.settings.bars_value | escape }}</span></div>
        <div class="bar-row"><div class="lab">{{ section.settings.zone1 | escape }}</div><div class="bar"><div class="seg" style="width:100%;background:linear-gradient(90deg,#E89379,#C76D54)"></div></div></div>
        <div class="bar-row"><div class="lab">{{ section.settings.zone2 | escape }}</div><div class="bar"><div class="seg" style="width:68%;background:linear-gradient(90deg,#E89379,#C76D54)"></div></div></div>
        <div class="bar-row"><div class="lab">{{ section.settings.zone3 | escape }}</div><div class="bar"><div class="seg" style="width:38%;background:linear-gradient(90deg,#E89379,#C76D54)"></div></div></div>

        <div class="lbl" style="margin-top:24px;"><span style="color:var(--muted)">{{ section.settings.flat_label | escape }}</span><span style="color:var(--muted)">{{ section.settings.flat_value | escape }}</span></div>
        <div class="bar-row"><div class="lab" style="color:var(--muted)">{{ section.settings.zone1 | escape }}</div><div class="bar"><div class="seg" style="width:100%;background:#C8A689"></div></div></div>
        <div class="bar-row"><div class="lab" style="color:var(--muted)">{{ section.settings.zone2 | escape }}</div><div class="bar"><div class="seg" style="width:100%;background:#C8A689"></div></div></div>
        <div class="bar-row"><div class="lab" style="color:var(--muted)">{{ section.settings.zone3 | escape }}</div><div class="bar"><div class="seg" style="width:100%;background:#C8A689"></div></div></div>
      </div>
    </div>

    <div class="science-illus">
      {%- if section.settings.illus_image != blank -%}
        <img class="ph" src="{{ section.settings.illus_image | image_url: width: 1000 }}" alt="{{ section.settings.illus_label | escape }}" width="1000" height="1250" loading="lazy" style="object-fit:cover;width:100%;height:100%;">
      {%- else -%}
        <div class="ph"><span class="ph-label">{{ section.settings.illus_label | escape }}</span></div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Aura Science",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "La science"
    },
    {
      "type": "html",
      "id": "heading",
      "label": "Heading",
      "default": "La pression qu'il faut à vos jambes."
    },
    {
      "type": "richtext",
      "id": "para1",
      "label": "Paragraph 1",
      "default": "<p>La vraie compression est <strong>graduée</strong>, pas uniforme : plus ferme à la cheville, plus souple vers le mollet. Cette fermeté à la cheville est voulue. C'est ce gradient qui ramène réellement le sang vers le cœur, au lieu de simplement comprimer la jambe.</p>"
    },
    {
      "type": "richtext",
      "id": "para2",
      "label": "Paragraph 2",
      "default": "<p>L'erreur la plus courante des compressions bon marché : la même pression de haut en bas. Ce n'est pas un soin, c'est un garrot.</p>"
    },
    {
      "type": "text",
      "id": "bars_label",
      "label": "Bars label",
      "default": "Aura · compression graduée"
    },
    {
      "type": "text",
      "id": "bars_value",
      "label": "Bars value",
      "default": "18–25 mmHg"
    },
    {
      "type": "text",
      "id": "zone1",
      "label": "Zone 1",
      "default": "Cheville"
    },
    {
      "type": "text",
      "id": "zone2",
      "label": "Zone 2",
      "default": "Mollet"
    },
    {
      "type": "text",
      "id": "zone3",
      "label": "Zone 3",
      "default": "Haut du mollet"
    },
    {
      "type": "text",
      "id": "flat_label",
      "label": "Flat compression label",
      "default": "Bas classique · compression plate"
    },
    {
      "type": "text",
      "id": "flat_value",
      "label": "Flat value",
      "default": "Pression identique"
    },
    {
      "type": "text",
      "id": "illus_label",
      "label": "Illustration caption",
      "default": "Schéma anatomique · retour veineux soléaire & mollet"
    },
    {
      "type": "image_picker",
      "id": "illus_image",
      "label": "Illustration (schéma anatomique)"
    }
  ]
}
{% endschema %}
