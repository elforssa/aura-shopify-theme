{% comment %}
  ----------------------------------------------------------------------------
  Section: Aura Statistics (FR)
  ----------------------------------------------------------------------------
  @description
    "Ce que nous garantissons" — eyebrow + heading, then a row of big-number stat
    blocks (number + suffix + label + optional graduated bar). Styles live in
    assets/aura-v2.css (.stats). Each stat is an editable block.
  @blocks
    - stat : number / suffix / label / bar % / highlight
  ----------------------------------------------------------------------------
{% endcomment %}

<section class="stats" data-section="statistics">
  <div class="stats-head">
    {%- if section.settings.eyebrow != blank -%}<div class="eyebrow">{{ section.settings.eyebrow | escape }}</div>{%- endif -%}
    <h2 class="h-display h-section">{{ section.settings.heading }}</h2>
    {%- if section.settings.lead != blank -%}<p class="lead">{{ section.settings.lead | escape }}</p>{%- endif -%}
  </div>

  <div class="stats-row">
    {%- for block in section.blocks -%}
      <div class="stat{% if block.settings.highlight %} stat--hl{% endif %}" {{ block.shopify_attributes }}>
        <div class="stat-num">{{ block.settings.number | escape }}<span class="stat-suffix">{{ block.settings.suffix | escape }}</span></div>
        <div class="stat-label">{{ block.settings.label | escape }}</div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Aura Statistics",
  "tag": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Ce que nous garantissons" },
    { "type": "html", "id": "heading", "label": "Heading", "default": "Des chiffres que l'on tient." },
    { "type": "text", "id": "lead", "label": "Subheading", "default": "Uniquement des engagements vérifiables : la pression mesurée, l'expédition et le remboursement." }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "18–25" },
        { "type": "text", "id": "suffix", "label": "Suffix" },
        { "type": "textarea", "id": "label", "label": "Label", "default": "mmHg de compression graduée, vérifiée en pression" },
        { "type": "checkbox", "id": "highlight", "label": "Highlight this stat", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Aura Statistics",
      "blocks": [
        { "type": "stat", "settings": { "number": "18–25", "suffix": "", "label": "mmHg de compression graduée, vérifiée en pression" } },
        { "type": "stat", "settings": { "number": "60", "suffix": "jours", "label": "pour être remboursée, même après les avoir portées", "highlight": true } },
        { "type": "stat", "settings": { "number": "24", "suffix": "h", "label": "pour expédier votre commande" } },
        { "type": "stat", "settings": { "number": "0", "suffix": "", "label": "couture à la pointe, aucun point de pression" } }
      ]
    }
  ]
}
{% endschema %}
