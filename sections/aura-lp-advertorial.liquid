        { "type": "richtext", "id": "text", "label": "Phrase au-dessus du bouton" },
        { "type": "text", "id": "label", "label": "Libellé du bouton", "default": "Découvrir Aura" },
        { "type": "url", "id": "link", "label": "Lien (laisser vide = descendre vers l'offre)" },
        { "type": "text", "id": "proof", "label": "Ligne de réassurance" }
