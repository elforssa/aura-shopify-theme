{% comment %}
  ----------------------------------------------------------------------------
  Section: Aura Softness (FR)
  ----------------------------------------------------------------------------
  @description
    Material "softness ladder" from the v2 design — four ranked rungs, the last
    highlighted. Styles in assets/aura-v2.css (.softness). Each rung is a block;
    "dots" (1–4) sets the fill rating.
  ----------------------------------------------------------------------------
{% endcomment %}

<section class="softness" data-section="softness">
  <div class="head">
    <div>
      <div class="eyebrow">{{ section.settings.eyebrow | escape }}</div>
      <h2 class="h-display h-section">{{ section.settings.heading | escape }}</h2>
    </div>
    <p class="lead">{{ section.settings.lead | escape }}</p>
  </div>
  <div class="ladder">
    {%- for block in section.blocks -%}
      <div class="rung{% if block.settings.best %} best{% endif %}" {{ block.shopify_attributes }}>
        {%- if block.settings.best and block.settings.flag != blank -%}<div class="corner-flag">{{ block.settings.flag | escape }}</div>{%- endif -%}
        <div class="level">{{ block.settings.level | escape }}</div>
        <div class="name">{{ block.settings.name }}</div>
        <div class="dots">
          {%- assign d = block.settings.dots | default: 1 -%}
          {%- for i in (1..4) -%}<i{% if i <= d %} class="on"{% endif %}></i>{%- endfor -%}
        </div>
        <div class="stretch">{{ block.settings.stretch | escape }}</div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Aura Softness",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Douceur de la matière"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Douce ? Plus douce que ce qu'on imagine d'une chaussette."
    },
    {
      "type": "text",
      "id": "lead",
      "label": "Subheading",
      "default": "Les matières les plus courantes, de la plus rigide à la plus douce, et celle que nous avons choisie."
    }
  ],
  "blocks": [
    {
      "type": "rung",
      "name": "Rung",
      "settings": [
        {
          "type": "text",
          "id": "level",
          "label": "Level",
          "default": "Rigide"
        },
        {
          "type": "html",
          "id": "name",
          "label": "Name",
          "default": "Polyester"
        },
        {
          "type": "range",
          "id": "dots",
          "label": "Rating (filled dots)",
          "min": 1,
          "max": 4,
          "step": 1,
          "default": 1
        },
        {
          "type": "textarea",
          "id": "stretch",
          "label": "Description",
          "default": "Description matière."
        },
        {
          "type": "checkbox",
          "id": "best",
          "label": "Highlight (dark)",
          "default": false
        },
        {
          "type": "text",
          "id": "flag",
          "label": "Corner flag",
          "default": "Ce qu'on utilise"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Aura Softness",
      "blocks": [
        {
          "type": "rung",
          "settings": {
            "level": "Rigide",
            "name": "Polyester",
            "dots": 1,
            "stretch": "Bon marché, étouffant, qui gratte. Le réflexe en dessous de 15 €."
          }
        },
        {
          "type": "rung",
          "settings": {
            "level": "Assez douce",
            "name": "Coton",
            "dots": 2,
            "stretch": "Respirant mais se détend, ne tient pas la compression au-delà de 10 h."
          }
        },
        {
          "type": "rung",
          "settings": {
            "level": "Plus douce",
            "name": "Viscose de bambou",
            "dots": 3,
            "stretch": "Agréable sur la peau, mais perd sa forme après un lavage chaud."
          }
        },
        {
          "type": "rung",
          "settings": {
            "level": "La plus douce",
            "name": "Aura — tricot 2 fils",
            "dots": 4,
            "best": true,
            "flag": "Ce qu'on utilise",
            "stretch": "Léger comme une seconde peau, résistant au lavage quotidien."
          }
        }
      ]
    }
  ]
}
{% endschema %}
